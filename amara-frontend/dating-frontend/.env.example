# Base URL of the Spring Boot backend (server.port=9395 by default)
VITE_API_BASE_URL=http://localhost:9395

# Razorpay checkout requires the PUBLIC key id (never the secret) on the frontend.
# Find it in your Razorpay dashboard — it should match the key used to sign
# orders on the backend (razorpay.key in application.properties).
VITE_RAZORPAY_KEY_ID=
